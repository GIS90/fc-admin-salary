# 本地环境
VITE_NODE_ENV = development


# 系统信息
VITE_SYSTEM_TITLE = 智行工具平台
VITE_SYSTEM_VERSION = 1.0.2
VITE_SYSTEM_FEATURE = 定制化 / 高性能 / 精优雅 / 智运营
VITE_SYSTEM_SUMMARY = 践行践远，智慧前行，总有一款工具让工作变得更加轻松，助你提质增效。


# 接口地址
VITE_VUE_API_BASEURL = http://127.0.0.1:8000/


# 模板文件
VITE_TEMPLATE_USER_IMPORT = http://2lstore.pygo.space/templates/%E7%B3%BB%E7%BB%9F%E7%94%A8%E6%88%B7%E6%89%B9%E9%87%8F%E5%AF%BC%E5%85%A5%E6%A8%A1%E6%9D%BF.xlsx

# 开发环境跨域代理，支持配置多个
VITE_PROXY = []

# 本地端口
VITE_VUE_PORT = 9527

# 首页地址
VITE_DASHBOARD_URL = /dashboard

# 请求超时
VITE_TIMEOUT = 15000

# Token名称
VITE_TOKEN_NAME = X-Token

# 本地存储localStorage是否加密, 为空不加密，加密方式可填写Base64/AES/DES/Rabbit/RC4,【本地环境可不加密便于调试】
VITE_LS_ENCRYPTION =

# 本地存储localStorageAES加密秘钥，位数建议填写8的倍数
VITE_LS_ENCRYPTION_KEY = 2XNN4K8LC0ELVWN4

# 是否禁止调试，建议正式环境设置true,开发环境设置为false
VITE_BAN_DEBUG = false

# 是否开启自定义注册
VITE_IS_REGISTRY = false

# 是否开启其他方式登录
VITE_IS_OTHER_LOGIN = false

# 文件上传默认最大数
VITE_VUE_APP_UPLOAD_FILES_LIMIT = 15
